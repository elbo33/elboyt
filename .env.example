# Optional. Future Claude/Claude Code adapters can read this.
ANTHROPIC_API_KEY=

# ElevenLabs text-to-speech, used only when you explicitly run voiceover commands.
ELEVEN_LABS_API_KEY=

# Override if Manim is installed in a specific Python environment.
# MANIM_PYTHON=/absolute/path/to/python

# Optional. elboyt reads local topics/, knowledge/, and exercises/ by default.
# Set only to compare against or temporarily use an external ZasPro checkout.
# ZASPRO_DIR=/absolute/path/to/ZasPro
