{
  "name": "elboyt",
  "version": "0.1.0",
  "private": true,
  "description": "Local Polish Matura video production pipeline using committed ZasPro curriculum YAML, Manim, Remotion, and FFmpeg.",
  "scripts": {
    "next": "tsc -p tsconfig.cli.json && node dist/cli/next.js",
    "generate:next": "tsc -p tsconfig.cli.json && node dist/cli/generateNext.js",
    "publish:ready": "tsc -p tsconfig.cli.json && node dist/cli/publishReady.js",
    "generate": "tsc -p tsconfig.cli.json && node dist/cli/generate.js",
    "publish": "tsc -p tsconfig.cli.json && node dist/cli/publish.js",
    "render:remotion": "remotion render src/remotion/index.ts MathLong generated/video.mp4",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.cli.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "js-yaml": "4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.516"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "typescript": "5.7.2"
  }
}
